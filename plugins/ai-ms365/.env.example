# Reference only. The plugin reads credentials from ~/.claude/.env/ms365.env
# at runtime — NOT from a .env in the plugin directory. To populate the real
# file: start Claude Code once after installing the plugin; run.js will create
# ~/.claude/.env/ms365.env.template that you copy to ~/.claude/.env/ms365.env
# and fill in.

MS365_MCP_CLIENT_ID=your-azure-app-client-id
MS365_MCP_TENANT_ID=your-azure-tenant-id
MS365_MCP_CLIENT_SECRET=your-client-secret
